<div class="fixed inset-0 overflow-hidden pointer-events-none [z-index:-1] bg-[#fdfaf5] dark:bg-[#0b1220] transition-colors duration-700">
  <!-- Dynamic Glowing Orbs -->
  <div class="absolute top-[10%] left-[20%] w-[500px] h-[500px] bg-primary/20 dark:bg-primary-dark/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] opacity-70 animate-[pulse_8s_ease-in-out_infinite]"></div>
  <div class="absolute top-[20%] right-[15%] w-[400px] h-[400px] bg-amber-200/30 dark:bg-amber-800/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[100px] opacity-60 animate-[pulse_10s_ease-in-out_infinite_2s]"></div>
  <div class="absolute -bottom-[20%] left-[40%] w-[600px] h-[600px] bg-blue-200/30 dark:bg-blue-900/20 rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-[120px] opacity-50 animate-[pulse_12s_ease-in-out_infinite_4s]"></div>

  <!-- Subtle Grid Overlay -->
  <svg aria-hidden="true" class="absolute inset-0 size-full fill-neutral-500/10 stroke-neutral-500/10 [mask-image:linear-gradient(to_bottom,white_10%,transparent_80%)]">
    <defs>
      <pattern id=":S1:" width="24" height="24" patternUnits="userSpaceOnUse" x="-1" y="-1">
        <path d="M.5 24V.5H24" fill="none" stroke-dasharray="0"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" stroke-width="0" fill="url(#:S1:)"></rect>
  </svg>
</div>
