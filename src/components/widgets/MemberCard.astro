---
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  member: {
    data: {
      name: string;
      role?: string;
      team?: string;
      email?: string;
      researchFocus?: string[];
      image?: string;
    }
  }
}

const { member } = Astro.props;
const { name, role, team, email, researchFocus, image } = member.data;

const defaultImage = "/assets/members/placeholder.jpg";
let displayImage = image || defaultImage;

// Server-side check if image exists to prevent slow 404s in the browser
if (image) {
  const absolutePath = path.join(process.cwd(), 'public', image);
  if (!fs.existsSync(absolutePath)) {
    displayImage = ''; // Set to empty to trigger the placeholder emoji immediately
  }
}
---

<div class="flex flex-col md:flex-row gap-8 p-6 mb-6 rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-white/50 dark:bg-neutral-900/50 transition-all hover:bg-neutral-50 dark:hover:bg-neutral-800/50">
  <div class="w-40 h-48 md:w-48 md:h-56 rounded-xl bg-neutral-200 dark:bg-neutral-800 flex-shrink-0 flex items-center justify-center overflow-hidden border border-neutral-200 dark:border-neutral-700">
    {displayImage ? (
      <img 
        src={displayImage} 
        alt={name} 
        class="w-full h-full object-cover"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        loading="lazy"
      />
      <div class="hidden text-4xl">👤</div>
    ) : (
      <div class="text-4xl flex items-center justify-center w-full h-full">👤</div>
    )}
  </div>
  <div class="flex-1">
    <h3 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-200">{name}</h3>
    {role && <p class="text-neutral-500 dark:text-neutral-400 mt-1 font-medium">{role}</p>}
    {team && <p class="text-neutral-500 dark:text-neutral-400">Team: {team}</p>}
    
    <div class="mt-4 space-y-1 text-sm text-neutral-600 dark:text-neutral-400">
      {email && <p>📧 Email: <a href={`mailto:${email}`} class="hover:text-primary-500 transition-colors">{email}</a></p>}
      
      {researchFocus && researchFocus.length > 0 && (
        <div class="mt-3">
          <p class="font-semibold text-neutral-700 dark:text-neutral-300">💡 Research Focus:</p>
          <ul class="list-disc list-inside mt-1 ml-1 space-y-1">
            {researchFocus.map(focus => (
              <li>{focus}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</div>
